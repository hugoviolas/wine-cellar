DATABASE_URL=file:./data/cave.db
SESSION_SECRET=changez-moi-en-une-chaine-aleatoire-d-au-moins-32-caracteres
BOOTSTRAP_EMAIL=vous@example.com
BOOTSTRAP_PASSWORD=changez-moi
BOOTSTRAP_CELLAR_NAME=Ma Cave
ANTHROPIC_API_KEY=
# Cookie de session marqué "Secure" ou non. Laissez vide en développement
# local (yarn dev) — le comportement par défaut convient. Pour un
# déploiement de production buildé (NODE_ENV=production), ne mettez
# "false" QUE si le navigateur accède à l'app en HTTP simple (ex. une
# préprod sur réseau local sans HTTPS) : un cookie Secure est rejeté par
# le navigateur sur une connexion non chiffrée, ce qui rend la connexion
# impossible même si le login réussit côté serveur. Laissez vide (ou
# "true") si le navigateur accède à l'app en HTTPS, y compris via un
# tunnel Cloudflare qui relaie ensuite en HTTP en interne — seule la
# connexion vue par le navigateur compte.
COOKIE_SECURE=

# Autorise la lecture de `x-forwarded-for` pour identifier le client dans le
# limiteur de débit. À ne mettre à "true" QUE si un reverse-proxy de
# confiance se trouve devant l'app et réécrit systématiquement cet en-tête.
# Laissé vide, l'en-tête est ignoré : n'importe quel client peut le poser
# lui-même, et s'offrir ainsi un compteur neuf à chaque requête. En
# production le tunnel Cloudflare fournit `cf-connecting-ip`, toujours
# préféré et non usurpable — cette variable n'y sert donc à rien.
TRUST_FORWARDED_FOR=
